#!/usr/bin/env python3
"""Exercise the exported release guard without calling GitHub or changing remote tags."""

import os
import re
import subprocess
import tempfile
import textwrap
from pathlib import Path


def guard(path):
    content = path.read_text()
    match = re.search(
        r"(?m)^      - name: Check for unreconciled release tags\n"
        r"        if: inputs.version == ''\n"
        r"        run: \|\n((?:          [^\n]*\n|\n)+)",
        content,
    )
    assert match, f"missing release guard in {path}"
    return textwrap.dedent(match.group(1))


source = guard(Path("src/.github/workflows/release.yaml"))
assert source == guard(Path(".github/workflows/release.yaml"))
assert not any(cmd in source for cmd in ("gh release delete", "git push", "git tag -d"))

# A run cancelled after the tag push must roll back too, or the guard above
# stops every later automatic release on the stranded tag.
for workflow in (Path("src/.github/workflows/release.yaml"), Path(".github/workflows/release.yaml")):
    assert "if: (failure() || cancelled()) && steps.plan.outputs.is-release == 'true'" in workflow.read_text(), workflow
    # The job gate must survive cancellation, or the job is cancelled before
    # the rollback step is evaluated.
    assert "if: always() && needs.ci.result == 'success' && github.ref == 'refs/heads/main'" in workflow.read_text(), workflow

fixture_env = {
    **os.environ,
    "GIT_AUTHOR_NAME": "Release fixture",
    "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
    "GIT_COMMITTER_NAME": "Release fixture",
    "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
}

for name, off_main, on_main, should_stop in (
    ("no version tags", None, None, False),
    ("first release interrupted", "v0.1.0", None, True),
    ("newer off-main release", "v0.2.0", "v0.1.0", True),
    ("older off-main release superseded", "v0.2.0", "v0.3.0", False),
    ("all tags on main", None, "v0.3.0", False),
    ("off-main prerelease of a released version", "v0.3.0-rc.1", "v0.3.0", False),
    ("off-main prerelease of a future version", "v0.4.0-rc.1", "v0.3.0", False),
    ("reachable prerelease does not supersede an off-main release", "v0.2.0", "v0.3.0-rc.1", True),
):
    with tempfile.TemporaryDirectory() as temp:
        def git(*args):
            return subprocess.run(
                ("git", *args), cwd=temp, env=fixture_env,
                check=True, capture_output=True, text=True,
            ).stdout.strip()

        git("init", "-q", "-b", "main")
        git("commit", "--allow-empty", "-qm", "initial")
        if off_main:
            git("switch", "-qc", "release-branch")
            git("commit", "--allow-empty", "-qm", "release commit")
            git("tag", off_main)
            git("switch", "-q", "main")
        if on_main:
            git("tag", on_main)

        tags_before = git("show-ref", "--tags") if off_main or on_main else ""
        result = subprocess.run(
            ("bash", "-e", "-c", source), cwd=temp,
            env=fixture_env, capture_output=True, text=True,
        )
        assert (result.returncode != 0) == should_stop, (name, result.stdout, result.stderr)
        assert tags_before == (git("show-ref", "--tags") if off_main or on_main else ""), name
        if should_stop:
            assert off_main in result.stdout and "Nothing was deleted" in result.stdout, name
        print(f"{name}: {'blocked safely' if should_stop else 'passed'}")
